# Copy to .env on the Pi and fill in. Never commit .env.
# Leave a system's variables empty to disable it.

# ---- app ----
DEMO_MODE=false                 # true = synthetic data, no devices needed
DASHBOARD_TOKEN=                # shared secret for the dashboard; generate with: openssl rand -hex 24
LOG_LEVEL=INFO
TAILSCALE_AUTHKEY=              # from https://login.tailscale.com/admin/settings/keys (reusable, tagged)

# ---- SolarEdge: monitoring portal -> Admin -> Site Access -> API Access ----
SOLAREDGE_SITE_ID=
SOLAREDGE_API_KEY=
SOLAREDGE_POLL_SECONDS=900      # 300 requests/day quota -> keep >= 600

# ---- Panasonic Comfort Cloud: SECOND account, units shared to it from the phone app, 2FA = SMS ----
PANASONIC_USERNAME=
PANASONIC_PASSWORD=
PANASONIC_POLL_SECONDS=120

# ---- ZTE G5B: router admin ----
ZTE_HOST=192.168.0.1
ZTE_PASSWORD=
ZTE_POLL_SECONDS=60

# ---- Rain Bird LNK WiFi: controller IP on the LAN + the password set in the Rain Bird app ----
RAINBIRD_HOST=
RAINBIRD_PASSWORD=
RAINBIRD_ZONES=8
RAINBIRD_POLL_SECONDS=90

# ---- AC Freedom / Broadlink AC module: run `python -m app.adapters.broadlink_ac --discover` on the LAN ----
BROADLINK_AC_HOST=
BROADLINK_AC_MAC=               # aa:bb:cc:dd:ee:ff
BROADLINK_AC_NAME=Guest room AC
BROADLINK_AC_DEVTYPE=0x4E2A      # only change if --discover shows another type for the AC module
BROADLINK_AC_POLL_SECONDS=60

# ---- Hikvision NVR (local ISAPI + RTSP). Create a dedicated user on the NVR. ----
HIK_NVR_HOST=
HIK_NVR_USERNAME=
HIK_NVR_PASSWORD=
HIK_NVR_POLL_SECONDS=60

# ---- Hik-Connect cloud (doorbell only) ----
HIKCONNECT_USERNAME=
HIKCONNECT_PASSWORD=
HIKCONNECT_POLL_SECONDS=120
